<?xml version="1.0" encoding="UTF-8"?>
<itemSchema>
  <field id="subject" name="Product Name" type="input">
    <input value="Original Safety Vest" />
  </field>
  <field id="product_summary" name="Product Summary" type="textarea">
    <textarea value="Original summary" />
  </field>
  <field id="product_faq" name="FAQ" type="complex">
    <complex-values>
      <complex-value>
        <input id="question_1" value="Original question 1?" />
        <input id="answer_1" value="Original answer 1." />
      </complex-value>
      <complex-value>
        <input id="question_2" value="Original question 2?" />
        <input id="answer_2" value="Original answer 2." />
      </complex-value>
      <complex-value>
        <input id="question_3" value="Original question 3?" />
        <input id="answer_3" value="Original answer 3." />
      </complex-value>
      <complex-value>
        <input id="question_4" value="Original question 4?" />
        <input id="answer_4" value="Original answer 4." />
      </complex-value>
      <complex-value>
        <input id="question_5" value="Original question 5?" />
        <input id="answer_5" value="Original answer 5." />
      </complex-value>
      <complex-value>
        <input id="question_6" value="Keep question 6?" />
        <input id="answer_6" value="Keep answer 6." />
      </complex-value>
    </complex-values>
  </field>
  <field id="custom_attributes" name="Custom Attributes" type="complex">
