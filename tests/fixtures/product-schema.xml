  <field id="sku" name="SKU" type="input">
    <input value="SKU-001" />
  </field>
  <field id="main_image" name="Main Image" type="images">
    <image value="https://example.invalid/main.jpg" />
  </field>
  <field id="future_field" name="Unknown Future Field" type="input">
    <input value="keep-me" />
  </field>
</itemSchema>
